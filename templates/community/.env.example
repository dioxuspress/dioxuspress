# 复制为 .env 并替换以下密钥（可用 `openssl rand -hex 32` 生成）
BASE_URL=http://127.0.0.1:8080
POSTGRES_PASSWORD=please_change_this_db_password
DATABASE_URL=postgres://dioxuspress:please_change_this_db_password@postgres:5432/dioxuspress
JWT_SECRET=please_replace_with_32_byte_random_hex_secret_value

# OAuth2 登录凭据（至少填写一组即可在顶栏启用对应登录渠道）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
