{
  "$schema": "https://dioxuspress.dev/schemas/site.schema.json",
  "site_name": "DioxusPress Community Starter",
  "site_description": "DioxusPress Community Starter — 集成知识文档、技术专栏、OAuth2 PKCE 登录、话题论坛与段落划线标注的开发者社区",
  "author": "Community Team",
  "default_language": "zh",
  "active_layout": "classic",
  "theme": "ocean",
  "available_themes": [
    "ocean",
    "emerald",
    "winter",
    "dracula",
    "nord"
  ],
  "hero": {
    "badge": "OAuth2 PKCE · Forum · Inline Annotations",
    "badge_en": "OAuth2 PKCE · Forum · Inline Annotations",
    "title": "DioxusPress Community Starter",
    "title_en": "DioxusPress Community Starter",
    "subtitle": "单个全栈二进制 + PostgreSQL 16，同时承载结构化知识库、技术博客、话题讨论区与文档段落划线批注。",
    "subtitle_en": "One fullstack binary + PostgreSQL 16 powering structured docs, blog essays, forum discussions, and paragraph annotations.",
    "primary_cta_text": "社区配置手册",
    "primary_cta_text_en": "Community Handbook",
    "primary_cta_href": "/docs/handbook/oauth-and-forum",
    "secondary_cta_text": "进入讨论区",
    "secondary_cta_text_en": "Visit Forum",
    "secondary_cta_href": "/topics"
  },
  "auth": {
    "enabled": true,
    "providers": [
      "github",
      "google",
      "discord"
    ]
  },
  "annotations": {
    "doc": true,
    "blog": true,
    "course": true
  },
  "moderation": {
    "enabled": true,
    "url_blocklist": [
      "spam.example",
      "*.phishing.example"
    ],
    "llm_review": false,
    "on_llm_failure": "review"
  },
  "modules": {
    "docs": { "enabled": true },
    "blog": { "enabled": true },
    "forum": { "enabled": true },
    "about": { "enabled": true },
    "cases": { "enabled": false },
    "podcast": { "enabled": false },
    "course": { "enabled": false },
    "papers": { "enabled": false },
    "embedded": { "enabled": false },
    "ai": { "enabled": false },
    "web3": { "enabled": false },
    "wasm": { "enabled": false },
    "cli": { "enabled": false }
  },
  "footer": {
    "tagline": "DioxusPress Community Starter · 开放共创的技术交流社区",
    "tagline_en": "DioxusPress Community Starter · Open developer community",
    "copyright": "DioxusPress Community Starter",
    "social": [
      {
        "label": "GitHub",
        "url": "https://github.com/dioxuspress/dioxuspress"
      }
    ]
  }
}
