# 复制为 .env 并替换以下密钥（可用 `openssl rand -hex 32` 生成）
BASE_URL=http://127.0.0.1:8080
POSTGRES_PASSWORD=please_change_this_db_password
DATABASE_URL=postgres://dioxuspress:please_change_this_db_password@postgres:5432/dioxuspress
JWT_SECRET=please_replace_with_32_byte_random_hex_secret_value

# OAuth2 登录凭据（回调地址：{BASE_URL}/api/auth/<provider>/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 可选：LLM 内容审核（填写后可将 site.json 中 moderation.llm_review 设为 true）
OPENAI_LLM_API_KEY=
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# 可选：课程商业化收款（Stripe Checkout / 微信支付 Native v3）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
